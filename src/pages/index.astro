---
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>THF Accesorios | Próximamente - Tienda Oficial</title>
    <meta name="description" content="Sitio oficial de THF Accesorios en construcción. Descubre muy pronto nuestra exclusiva colección de joyería, relojes y accesorios de moda." />
    <meta property="og:title" content="THF Accesorios | Próximamente" />
    <meta property="og:description" content="Estamos preparando algo extraordinario. Accesorios exclusivos de alta calidad." />
    <meta property="og:image" content="/logo.png" />
  </head>
  <body>
    <!-- Ambient Background Lighting -->
    <div class="bg-canvas" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="noise-overlay"></div>
    </div>

    <!-- Main Container -->
    <div class="page-wrapper">
      
      <!-- Top Bar -->
      <header class="top-nav">
        <div class="status-badge">
          <span class="pulse-dot"></span>
          <span class="badge-text">SITIO EN CONSTRUCCIÓN</span>
        </div>
        <div class="exclusive-tag">
          <span>COLECCIÓN EXCLUSIVA</span>
        </div>
      </header>

      <!-- Main Content Card -->
      <main class="main-card glass-card">
        
        <!-- Brand Logo Showcase -->
        <div class="logo-wrapper">
          <div class="logo-glow"></div>
          <div class="logo-frame">
            <img 
              src="/logo.png" 
              alt="Logo Oficial THF Accesorios" 
              class="brand-logo" 
              loading="eager"
            />
          </div>
        </div>

        <!-- Hero Texts -->
        <div class="hero-content">
          <p class="eyebrow-script font-script">Elegancia & Sofisticación</p>
          <h1 class="main-title font-serif gold-gradient-text">
            Muy Pronto
          </h1>
          <p class="subtitle">
            Estamos preparando una nueva experiencia digital con las piezas y accesorios más exclusivos. Muy pronto abriremos las puertas de nuestra tienda en línea.
          </p>
        </div>

        <!-- VIP Early Access / Newsletter Form -->
        <section class="subscribe-section">
          <div class="subscribe-header">
            <h2 class="subscribe-title font-serif">Sé el primero en enterarte</h2>
            <p class="subscribe-desc">
              Déjanos tu correo para avisarte en cuanto inauguremos la tienda y obtener un <strong>beneficio especial</strong> de apertura.
            </p>
          </div>

          <form class="subscribe-form" id="vipForm">
            <div class="input-group">
              <svg class="mail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <input 
                type="email" 
                id="emailInput" 
                placeholder="Ingresa tu correo electrónico..." 
                required 
                autocomplete="email"
              />
              <button type="submit" class="submit-btn" id="submitBtn">
                <span>Notificarme</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-icon">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </div>
            <p class="form-feedback" id="formFeedback"></p>
          </form>
        </section>

        <!-- Direct Contact & Social Links -->
        <footer class="footer-section">
          <p class="contact-prompt">Síguenos y mantente conectado:</p>
          <div class="social-links">
            <a 
              href="https://www.instagram.com/thfaccesorios" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="social-btn instagram-btn"
              title="Síguenos en Instagram"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="social-icon">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>Instagram</span>
            </a>

            <a 
              href="https://www.facebook.com/thfaccesorios" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="social-btn facebook-btn"
              title="Síguenos en Facebook"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="social-icon">
                <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
              </svg>
              <span>Facebook</span>
            </a>

            <a 
              href="mailto:info@thfaccesorios.com" 
              class="social-btn email-btn"
              title="Envíanos un correo electrónico"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="social-icon">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>info@thfaccesorios.com</span>
            </a>
          </div>

          <div class="footer-bottom">
            <p>© {new Date().getFullYear()} <strong>THF ACCESORIOS</strong>. Todos los derechos reservados.</p>
            <p class="craft-tag">
              Hecho con distinción por <a href="https://www.theoideas.com/" target="_blank" rel="noopener noreferrer" class="agency-link">Theo Ideas</a>
            </p>
          </div>
        </footer>

      </main>
    </div>

    <!-- Client-side Interactive Logic -->
    <script is:inline>
      const vipForm = document.getElementById('vipForm');
      const emailInput = document.getElementById('emailInput');
      const formFeedback = document.getElementById('formFeedback');
      const submitBtn = document.getElementById('submitBtn');

      if (vipForm) {
        vipForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = emailInput.value.trim();

          if (!email) return;

          submitBtn.disabled = true;
          const originalBtnContent = submitBtn.innerHTML;
          submitBtn.innerHTML = `<span>Enviando...</span>`;

          try {
            // Envío provisional directo a info@thfaccesorios.com vía FormSubmit AJAX
            const response = await fetch('https://formsubmit.co/ajax/info@thfaccesorios.com', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({
                email: email,
                _subject: '✨ Nuevo Suscriptor VIP - THF Accesorios',
                _template: 'table',
                _captcha: 'false',
                fecha: new Date().toLocaleString('es-ES')
              })
            });

            // Guardar también copia de respaldo en localStorage
            try {
              const subscribers = JSON.parse(localStorage.getItem('thf_subscribers') || '[]');
              subscribers.push({ email, date: new Date().toISOString() });
              localStorage.setItem('thf_subscribers', JSON.stringify(subscribers));
            } catch (err) {
              console.warn(err);
            }

            if (response.ok) {
              formFeedback.innerHTML = '✨ <strong>¡Gracias por suscribirte!</strong> Tu correo ha sido registrado con éxito. Te notificaremos con prioridad.';
              formFeedback.className = 'form-feedback success';
              emailInput.value = '';
              submitBtn.innerHTML = `<span>¡Listo!</span> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-icon" style="width:18px"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
            } else {
              throw new Error('Error al enviar');
            }
          } catch (error) {
            // En caso de problema de conexión, se guardó el respaldo localmente
            formFeedback.innerHTML = '✨ <strong>¡Gracias por suscribirte!</strong> Hemos registrado tu solicitud de acceso VIP.';
            formFeedback.className = 'form-feedback success';
            emailInput.value = '';
            submitBtn.innerHTML = `<span>Suscrito</span>`;
          } finally {
            submitBtn.disabled = false;
          }
        });
      }
    </script>

    <style>
      .page-wrapper {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.25rem;
        position: relative;
        z-index: 2;
      }

      /* Top Navigation */
      .top-nav {
        width: 100%;
        max-width: 760px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding: 0 0.5rem;
      }

      .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(61, 16, 17, 0.45);
        border: 1px solid rgba(231, 214, 195, 0.25);
        padding: 6px 16px;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: var(--color-sand);
        box-shadow: 0 4px 15px rgba(61, 16, 17, 0.3);
      }

      .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: #e57373;
        border-radius: 50%;
        box-shadow: 0 0 10px #e57373;
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%, 100% {
          opacity: 1;
          transform: scale(1);
        }
        50% {
          opacity: 0.4;
          transform: scale(0.85);
        }
      }

      .exclusive-tag {
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        color: var(--color-sand);
        opacity: 0.8;
        font-weight: 500;
      }

      /* Main Card */
      .main-card {
        width: 100%;
        max-width: 760px;
        padding: 4rem 2.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
      }

      /* Logo Frame Showcase */
      .logo-wrapper {
        position: relative;
        margin-bottom: 2rem;
      }

      .logo-glow {
        position: absolute;
        inset: -20px;
        background: radial-gradient(circle, rgba(231, 214, 195, 0.28) 0%, rgba(61, 16, 17, 0.25) 60%, transparent 100%);
        border-radius: 50%;
        filter: blur(25px);
        z-index: 0;
      }

      .logo-frame {
        position: relative;
        z-index: 1;
        width: 175px;
        height: 175px;
        background: #ffffff;
        border-radius: 28px;
        padding: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 
          0 16px 36px rgba(0, 0, 0, 0.6),
          0 0 0 1px rgba(231, 214, 195, 0.5),
          0 0 35px rgba(25, 37, 67, 0.4);
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
      }

      .logo-frame:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 
          0 22px 45px rgba(0, 0, 0, 0.7),
          0 0 0 2px var(--color-sand),
          0 0 45px rgba(212, 175, 55, 0.4);
      }

      .brand-logo {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      /* Hero Content */
      .hero-content {
        max-width: 620px;
        margin-bottom: 2.75rem;
      }

      .eyebrow-script {
        font-size: 2.2rem;
        color: var(--color-sand);
        opacity: 0.95;
        margin-bottom: 0.25rem;
        line-height: 1.2;
      }

      .main-title {
        font-size: clamp(2.6rem, 6.5vw, 4.2rem);
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 1.25rem;
        line-height: 1.1;
      }

      .subtitle {
        font-size: 1.08rem;
        line-height: 1.75;
        color: rgba(231, 214, 195, 0.9);
        font-weight: 300;
      }

      /* Subscribe Section */
      .subscribe-section {
        width: 100%;
        max-width: 600px;
        background: linear-gradient(180deg, rgba(61, 16, 17, 0.35) 0%, rgba(25, 37, 67, 0.4) 100%);
        border: 1px solid rgba(231, 214, 195, 0.2);
        border-radius: 20px;
        padding: 2.25rem 2rem;
        margin-bottom: 3rem;
      }

      .subscribe-header {
        margin-bottom: 1.5rem;
      }

      .subscribe-title {
        font-size: 1.35rem;
        letter-spacing: 0.04em;
        margin-bottom: 0.6rem;
        color: #ffffff;
      }

      .subscribe-desc {
        font-size: 0.92rem;
        color: rgba(231, 214, 195, 0.85);
        line-height: 1.55;
      }

      .subscribe-desc strong {
        color: var(--color-gold-light);
      }

      .subscribe-form {
        width: 100%;
      }

      .input-group {
        display: flex;
        align-items: center;
        background: rgba(13, 18, 31, 0.8);
        border: 1px solid rgba(231, 214, 195, 0.3);
        border-radius: 14px;
        padding: 6px 8px 6px 14px;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
      }

      .input-group:focus-within {
        border-color: var(--color-sand);
        box-shadow: 0 0 20px rgba(231, 214, 195, 0.2);
      }

      .mail-icon {
        width: 20px;
        height: 20px;
        color: var(--color-sand);
        opacity: 0.6;
        margin-right: 10px;
        flex-shrink: 0;
      }

      .input-group input {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: #ffffff;
        font-size: 0.95rem;
        font-family: var(--font-sans);
      }

      .input-group input::placeholder {
        color: rgba(231, 214, 195, 0.45);
      }

      .submit-btn {
        background: linear-gradient(135deg, #192543 0%, #3d1011 100%);
        border: 1px solid rgba(231, 214, 195, 0.4);
        color: var(--color-sand);
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 0.9rem;
        letter-spacing: 0.04em;
        padding: 10px 20px;
        border-radius: 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        white-space: nowrap;
      }

      .submit-btn:hover {
        background: linear-gradient(135deg, #253761 0%, #561719 100%);
        border-color: var(--color-sand);
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(61, 16, 17, 0.4);
      }

      .arrow-icon {
        width: 16px;
        height: 16px;
        transition: transform 0.2s ease;
      }

      .submit-btn:hover .arrow-icon {
        transform: translateX(3px);
      }

      .form-feedback {
        font-size: 0.88rem;
        margin-top: 0.85rem;
        min-height: 20px;
        transition: all 0.3s ease;
      }

      .form-feedback.success {
        color: #b7e4c7;
      }

      /* Footer */
      .footer-section {
        width: 100%;
        border-top: 1px solid rgba(231, 214, 195, 0.15);
        padding-top: 2.25rem;
      }

      .contact-prompt {
        font-size: 0.95rem;
        color: var(--color-sand);
        opacity: 0.85;
        margin-bottom: 1.25rem;
      }

      .social-links {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2.25rem;
      }

      .social-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: 9999px;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 500;
        color: var(--color-sand);
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(231, 214, 195, 0.2);
        transition: all 0.3s ease;
      }

      .social-btn:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: var(--color-sand);
        transform: translateY(-2px);
      }

      .social-icon {
        width: 18px;
        height: 18px;
      }

      .instagram-btn:hover {
        color: #f7a8b8;
        border-color: #f7a8b8;
        box-shadow: 0 4px 15px rgba(247, 168, 184, 0.25);
      }

      .facebook-btn:hover {
        color: #93c5fd;
        border-color: #93c5fd;
        box-shadow: 0 4px 15px rgba(147, 197, 253, 0.25);
      }

      .email-btn:hover {
        color: var(--color-gold-light);
        border-color: var(--color-gold-light);
        box-shadow: 0 4px 15px rgba(243, 229, 171, 0.25);
      }

      .footer-bottom {
        font-size: 0.82rem;
        opacity: 0.8;
        line-height: 1.7;
      }

      .craft-tag {
        font-size: 0.8rem;
        margin-top: 0.35rem;
        opacity: 0.9;
      }

      .agency-link {
        color: var(--color-gold-light);
        text-decoration: underline;
        text-underline-offset: 3px;
        font-weight: 600;
        transition: color 0.2s ease, text-shadow 0.2s ease;
      }

      .agency-link:hover {
        color: #ffffff;
        text-shadow: 0 0 10px rgba(243, 229, 171, 0.6);
      }

      /* Responsive Adjustments */
      @media (max-width: 640px) {
        .main-card {
          padding: 2.5rem 1.25rem;
          border-radius: 20px;
        }

        .top-nav {
          flex-direction: column;
          gap: 0.75rem;
          text-align: center;
        }

        .input-group {
          flex-direction: column;
          background: transparent;
          border: none;
          padding: 0;
          gap: 0.75rem;
        }

        .input-group input {
          width: 100%;
          background: rgba(13, 18, 31, 0.8);
          border: 1px solid rgba(231, 214, 195, 0.3);
          border-radius: 12px;
          padding: 12px 14px;
        }

        .mail-icon {
          display: none;
        }

        .submit-btn {
          width: 100%;
          justify-content: center;
          padding: 12px;
        }

        .social-links {
          flex-direction: column;
          width: 100%;
        }

        .social-btn {
          justify-content: center;
          width: 100%;
        }
      }
    </style>
  </body>
</html>
